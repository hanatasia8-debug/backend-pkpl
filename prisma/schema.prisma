datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =====================================
// A. SYSTEM / AUTH
// =====================================

model Role {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(256)
  description String? @db.VarChar(256)

  users       User[]

  @@map("roles")
}

model User {
  id        String    @id @db.Uuid
  roleId    BigInt    @map("role_id")
  name      String    @db.VarChar(256)
  email     String    @unique(map: "users_email_uq") @db.VarChar(256)
  lastLogin DateTime? @map("last_login") @db.Timestamptz

  role      Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_role_fk")

  @@index([roleId], map: "users_role_idx")
  @@map("users")
}

// =====================================
// B. WEBSITE / IDENTITAS DESA
// =====================================

model WebsiteSetting {
  id          BigInt  @id @default(autoincrement())
  websiteName String? @map("website_name") @db.VarChar(256)
  logoUrl     String  @map("logo_url") @db.Text
  faviconUrl  String  @map("favicon_url") @db.Text
  email       String  @db.VarChar(256)
  phone       String  @db.VarChar(256)
  address     String  @db.VarChar(256)
  facebook    String? @db.VarChar(256)
  instagram   String? @db.VarChar(256)
  youtube     String? @db.VarChar(256)
  tiktok      String? @db.VarChar(256)

  @@map("website_setting")
}

model VillageProfile {
  id                BigInt            @id @default(autoincrement())
  villageName       String            @map("village_name") @db.VarChar(256)
  headGreeting      String            @map("head_greeting") @db.Text
  headPhoto         String            @map("head_photo") @db.Text
  aboutText         String?           @map("about_text") @db.Text
  address           String            @db.VarChar(256)
  phone             String            @db.VarChar(256)
  email             String?           @db.VarChar(256)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  officials         VillageOfficial[]

  @@map("village_profile")
}

model VillageOfficial {
  id               BigInt         @id @default(autoincrement())
  villageProfileId BigInt         @map("village_profile_id")
  name             String         @db.VarChar(256)
  position         String         @db.VarChar(256)
  photoUrl         String         @map("photo_url") @db.Text
  email            String?        @db.VarChar(256)
  greeting         String?        @db.VarChar(256)

  villageProfile   VillageProfile @relation(fields: [villageProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "official_profile_fk")

  @@index([villageProfileId], map: "village_official_profile_idx")
  @@map("village_officials")
}

// =====================================
// C. UMKM
// =====================================

model UmkmCategory {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(256)
  slug        String  @unique(map: "umkm_category_slug_uq") @db.VarChar(256)
  description String? @db.Text

  umkms       Umkm[]

  @@map("umkm_category")
}

model Umkm {
  id                 BigInt            @id @default(autoincrement())
  umkmCategoryId     BigInt            @map("umkm_category_id")
  name               String            @db.VarChar(256)
  slug               String            @unique(map: "umkm_slug_uq") @db.VarChar(256)
  ownerName          String            @map("owner_name") @db.VarChar(256)
  description        String            @db.Text
  phone              String            @db.VarChar(20)
  email              String?           @db.VarChar(256)
  address            String            @db.VarChar(256)
  coverUrl           String?           @map("cover_url") @db.Text
  latitude           Decimal?          @db.Decimal(10, 8)
  longitude          Decimal?          @db.Decimal(11, 8)
  mapsUrl            String?           @map("maps_url") @db.VarChar(512)
  openDay            String?           @map("open_day") @db.VarChar(256)
  startTime          DateTime?         @map("start_time") @db.Time
  endTime            DateTime?         @map("end_time") @db.Time
  since              Int?
  status             String            @db.VarChar(50)
  rejectionReason    String?           @map("rejection_reason") @db.Text
  publishedAt        DateTime?         @map("published_at") @db.Timestamptz

  category           UmkmCategory      @relation(fields: [umkmCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "umkm_category_fk")
  
  products           Product[]
  galleries          UmkmGallery[]
  newsUmkms          NewsUmkm[]

  @@index([umkmCategoryId], map: "umkm_category_idx")
  @@index([status], map: "umkm_status_idx")
  @@map("umkm")
}

model UmkmGallery {
  id       BigInt  @id @default(autoincrement())
  umkmId   BigInt  @map("umkm_id")
  imageUrl String  @map("image_url") @db.Text
  caption  String? @db.VarChar(256)

  umkm     Umkm    @relation(fields: [umkmId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "umkm_gallery_fk")

  @@index([umkmId], map: "umkm_gallery_idx")
  @@map("umkm_gallery")
}

// =====================================
// E. PRODUCT
// =====================================

model Product {
  id           BigInt        @id @default(autoincrement())
  umkmId       BigInt        @map("umkm_id")
  name         String        @db.VarChar(256)
  imageUrl     String?       @map("image_url") @db.Text
  description  String        @db.Text
  price        Decimal?      @db.Decimal(12, 2)

  umkm         Umkm          @relation(fields: [umkmId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_umkm_fk")
  newsProducts NewsProduct[]

  @@index([umkmId], map: "product_umkm_idx")
  @@map("product")
}

// =====================================
// F. NEWS
// =====================================

model NewsCategory {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(50)
  slug        String  @unique(map: "news_category_slug_uq") @db.VarChar(256)
  description String? @db.VarChar(256)

  news        News[]

  @@map("news_category")
}

model NewsType {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(256)
  slug        String  @unique(map: "news_type_slug_uq") @db.VarChar(256)
  description String? @db.Text

  news        News[]

  @@map("news_type")
}

model News {
  id              BigInt          @id @default(autoincrement())
  newsCategoryId  BigInt          @map("news_category_id")
  newsTypeId      BigInt          @map("news_type_id")
  title           String          @db.VarChar(256)
  slug            String          @unique(map: "news_slug_uq") @db.VarChar(256)
  excerpt         String          @db.Text
  coverUrl        String?         @map("cover_url") @db.Text
  status          String          @db.VarChar(15)
  rejectionReason String?         @map("rejection_reason") @db.Text
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz

  category        NewsCategory    @relation(fields: [newsCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "news_category_fk")
  type            NewsType        @relation(fields: [newsTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "news_type_fk")
  
  articleDetail   ArticleDetail?
  galleryDetail   GalleryDetail?
  
  newsUmkms       NewsUmkm[]
  newsProducts    NewsProduct[]

  @@index([newsCategoryId], map: "news_category_idx")
  @@index([newsTypeId], map: "news_type_idx")
  @@index([status], map: "news_status_idx")
  @@index([publishedAt(sort: Desc)], map: "news_published_idx")
  @@map("news")
}

// =====================================
// G. ARTICLE & GALLERY DETAIL
// =====================================

model ArticleDetail {
  id       BigInt         @id @default(autoincrement())
  newsId   BigInt         @unique(map: "article_detail_news_uq") @map("news_id")

  news     News           @relation(fields: [newsId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_news_fk")
  blocks   ArticleBlock[]

  @@map("article_detail")
}

model ArticleBlock {
  id              BigInt        @id @default(autoincrement())
  articleDetailId BigInt        @map("article_detail_id")
  subHeading      String?       @map("sub_heading") @db.VarChar(256)
  content         String        @db.Text
  imageUrl        String?       @map("image_url") @db.Text
  sortOrder       Int           @map("sort_order")

  articleDetail   ArticleDetail @relation(fields: [articleDetailId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "article_block_fk")

  @@index([articleDetailId], map: "article_block_detail_idx")
  @@map("article_block")
}

model GalleryDetail {
  id       BigInt         @id @default(autoincrement())
  newsId   BigInt         @unique(map: "gallery_detail_news_uq") @map("news_id")

  news     News           @relation(fields: [newsId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gallery_news_fk")
  images   GalleryImage[]

  @@map("gallery_detail")
}

model GalleryImage {
  id               BigInt        @id @default(autoincrement())
  galleryDetailId  BigInt        @map("gallery_detail_id")
  imageUrl         String        @map("image_url") @db.Text
  imageDescription String?       @map("image_description") @db.VarChar(256)
  sortOrder        Int           @map("sort_order")

  galleryDetail    GalleryDetail @relation(fields: [galleryDetailId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "gallery_image_fk")

  @@index([galleryDetailId], map: "gallery_image_detail_idx")
  @@map("gallery_image")
}

// =====================================
// H. NEWS RELATIONS (N:N)
// =====================================

model NewsUmkm {
  newsId BigInt @map("news_id")
  umkmId BigInt @map("umkm_id")

  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "news_umkm_news_fk")
  umkm   Umkm   @relation(fields: [umkmId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "news_umkm_umkm_fk")

  @@id([newsId, umkmId])
  @@index([umkmId], map: "news_umkm_umkm_idx")
  @@map("news_umkm")
}

model NewsProduct {
  newsId    BigInt  @map("news_id")
  productId BigInt  @map("product_id")

  news      News    @relation(fields: [newsId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "news_product_news_fk")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "news_product_product_fk")

  @@id([newsId, productId])
  @@index([productId], map: "news_product_product_idx")
  @@map("news_product")
}
